<!-- LIGHTBOX -->


<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>

// Scroll reveal
const revEls = document.querySelectorAll('.reveal');
revEls.forEach(el => el.classList.add('will-animate'));
const ro = new IntersectionObserver(entries => {
  entries.forEach(e => {
    if (!e.isIntersecting) return;
    const siblings = [...e.target.parentElement.querySelectorAll('.reveal:not(.in)')];
    const idx = siblings.indexOf(e.target);
    setTimeout(() => e.target.classList.add('in'), Math.min(idx,4)*65);
    ro.unobserve(e.target);
  });
}, { threshold:.08, rootMargin:'0px 0px -24px 0px' });
revEls.forEach(el => ro.observe(el));

// FAB
const fab = document.getElementById('fab');
window.addEventListener('scroll', () => fab.classList.toggle('visible', scrollY > 380), {passive:true});

// Connect to WiFi
function connectWifi(e) {
  e.preventDefault();
  const ssid = 'VILLACORSU20171';
  const pwd  = 'villa.corsu!2423';
  const btn  = document.getElementById('wifi-btn');

  // Build WiFi URI (works on Android; iOS uses wifi:// via shortcuts)
  // Try android wifi config intent first, fallback to wifi:// URI
  const isIOS = /iphone|ipad|ipod/i.test(navigator.userAgent);
  const isAndroid = /android/i.test(navigator.userAgent);

  if (isAndroid) {
    // Android: open WiFi settings via intent (opens system WiFi on some launchers)
    window.location.href = 'intent://wifi/#Intent;scheme=wifi;end';
    setTimeout(() => {
      // Fallback: copy password and tell user
      navigator.clipboard.writeText(pwd).catch(()=>{});
      btn.textContent = '✓ Mdp copié — activez le WiFi manuellement';
      btn.style.background = '#4a6741';
      setTimeout(() => { btn.textContent = '📶 Connexion au WiFi'; btn.style.background = ''; }, 4000);
    }, 800);
  } else if (isIOS) {
    // iOS 16+: wifi:// scheme
    window.location.href = `wifi://${ssid}:${pwd}`;
    setTimeout(() => {
      navigator.clipboard.writeText(pwd).catch(()=>{});
      btn.textContent = '✓ Mdp copié — activez le WiFi manuellement';
      btn.style.background = '#4a6741';
      setTimeout(() => { btn.textContent = '📶 Connexion au WiFi'; btn.style.background = ''; }, 4000);
    }, 800);
  } else {
    // Desktop: copy password + show instructions
    navigator.clipboard.writeText(pwd).then(() => {
      btn.textContent = '✓ Mot de passe copié dans le presse-papiers';
      btn.style.background = '#4a6741';
      setTimeout(() => { btn.textContent = '📶 Connexion au WiFi'; btn.style.background = ''; }, 3000);
    }).catch(() => {
      btn.textContent = `Réseau : ${ssid} · Mdp : ${pwd}`;
      setTimeout(() => { btn.textContent = '📶 Connexion au WiFi'; }, 4000);
    });
  }
}

// Active nav pill on scroll
const pills = document.querySelectorAll('.nav-pill[data-section]');
const sections = [...pills].map(p => document.getElementById(p.dataset.section)).filter(Boolean);
const pillsNav = document.getElementById('nav-pills');

function updateActivePill() {
  let current = null;
  sections.forEach(s => {
    if (s.getBoundingClientRect().top <= 140) current = s.id;
  });
  pills.forEach(p => {
    const isActive = p.dataset.section === current;
    p.classList.toggle('active', isActive);
    if (isActive) {
      // scroll pill into view within the nav-pills bar
      p.scrollIntoView({ behavior:'smooth', block:'nearest', inline:'center' });
    }
  });
}
window.addEventListener('scroll', updateActivePill, { passive:true });

// Smooth scroll offset for sticky bars
document.querySelectorAll('.nav-pill[href^="#"]').forEach(a => {
  a.addEventListener('click', e => {
    e.preventDefault();
    const target = document.getElementById(a.dataset.section);
    if (!target) return;
    const offset = 130; // topbar + pills height
    const top = target.getBoundingClientRect().top + window.scrollY - offset;
    window.scrollTo({ top, behavior:'smooth' });
  });
});
// setLang définie dans <head>
</script>

<!-- Lightbox -->
<div id="lb" onclick="if(event.target===this)lbHide()">
  <button id="lb-close" onclick="lbHide()">&#x2715;</button>
  <img id="lb-img" src="" alt="">
</div>