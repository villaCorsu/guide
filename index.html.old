<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
<meta name="theme-color" content="#1a1612">
<title>La Villa Corsu — Le Guide</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;0,500;1,400;1,500&family=Outfit:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --bg: #f4f0e8;
  --bg2: #ede8de;
  --card: #f9f6f0;
  --gold: #9a8660;
  --gold-light: #b8a07a;
  --gold-pale: #e8dfc8;
  --dark: #1a1612;
  --mid: #3d3428;
  --muted: #7a6e5e;
  --white: #faf8f4;
  --red: #c0392b;
  --green: #4a6741;
  --radius: 16px;
  --shadow: 0 2px 20px rgba(26,22,18,0.08);
  --shadow-lg: 0 8px 40px rgba(26,22,18,0.14);
}
* { margin:0; padding:0; box-sizing:border-box; -webkit-tap-highlight-color:transparent; }
html { scroll-behavior:smooth; }
body { font-family:'Outfit',sans-serif; background:var(--bg); color:var(--dark); overflow-x:hidden; font-size:16px; line-height:1.6; }

/* ── TOPBAR ── */
.topbar {
  position:sticky; top:0; z-index:200;
  background:rgba(26,22,18,0.96);
  backdrop-filter:blur(12px); -webkit-backdrop-filter:blur(12px);
  display:flex; align-items:center; justify-content:space-between;
  padding:14px 20px; gap:12px;
}
.topbar-logo { display:flex; align-items:center; gap:10px; }
.logo-video { width:62px; height:62px; flex-shrink:0; border-radius:8px; object-fit:cover; }
.logo-text { font-family:'Playfair Display',serif; font-size:1rem; color:var(--white); letter-spacing:.05em; line-height:1.2; }
.logo-text small { display:block; font-family:'Outfit',sans-serif; font-size:.62rem; font-weight:300; letter-spacing:.2em; color:var(--gold-light); text-transform:uppercase; }
.lang-toggle { display:flex; gap:6px; }
.lang-btn { background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.12); border-radius:8px; padding:6px 10px; font-size:1.1rem; cursor:pointer; transition:background .2s; line-height:1; }
.lang-btn.active { background:var(--gold); border-color:var(--gold); }
.lang-btn:active { transform:scale(.93); }

/* ── HERO ── */
.hero {
  background:#000;
  display:flex; align-items:center; justify-content:center;
  position:relative; overflow:hidden;
  padding:28px 24px;
}
.hero-logo-img {
  position:relative;
  z-index:2;
  width:min(420px, 85vw);
  display:block;
}

/* Marquee hero */
.hero-marquee {
  position:absolute; inset:0; z-index:3;
  display:flex; align-items:center;
  overflow:hidden; pointer-events:none;
}
.hero-marquee-track {
  display:flex; gap:80px; white-space:nowrap;
  animation:marquee 36s linear infinite;
  will-change:transform;
}
.hero-marquee-track span {
  font-family:'Playfair Display',serif;
  font-size:var(--hero-h, 120px);
  font-weight:400; font-style:italic;
  color:rgba(255,255,255,.1);
  letter-spacing:.1em;
  text-transform:uppercase;
  user-select:none;
  line-height:1;
}
@keyframes marquee {
  from { transform:translateX(0); }
  to   { transform:translateX(-50%); }
}
.hero-content {
  position:absolute;
  bottom:16px; left:24px;
  z-index:3;
  width:calc(100% - 48px);
}
.hero-bg {
  position:absolute; inset:0;
  background:#000;
}
.hero-grid {
  position:absolute; inset:0; opacity:.04;
  background-image:repeating-linear-gradient(0deg,var(--gold) 0,var(--gold) 1px,transparent 0,transparent 40px),
                   repeating-linear-gradient(90deg,var(--gold) 0,var(--gold) 1px,transparent 0,transparent 40px);
  background-color:#000;
}
.hero-content { position:relative; z-index:2; width:100%; }
.hero-badge {
  display:inline-block; font-size:.65rem; font-weight:500; letter-spacing:.25em;
  text-transform:uppercase; color:var(--gold-light);
  border:1px solid rgba(154,134,96,.35); border-radius:20px; padding:5px 12px; margin-bottom:14px;
}
.hero h1 { font-family:'Playfair Display',serif; font-size:clamp(2.2rem,8vw,3.4rem); font-weight:400; color:var(--white); line-height:1.05; margin-bottom:6px; }
.hero h1 em { font-style:italic; color:var(--gold-light); }
.hero-sub { font-size:.85rem; font-weight:300; color:rgba(250,248,244,.45); margin-top:8px; }

/* ── SECTIONS ── */
.section { padding:28px 20px; }
.section-header { margin-bottom:18px; }
.chip { display:inline-block; font-size:.6rem; font-weight:600; letter-spacing:.25em; text-transform:uppercase; color:var(--gold); background:rgba(154,134,96,.12); border-radius:20px; padding:4px 10px; margin-bottom:8px; }
.section-title { font-family:'Playfair Display',serif; font-size:clamp(1.5rem,5vw,2rem); font-weight:400; color:var(--dark); line-height:1.2; }
.section-title em { font-style:italic; color:var(--gold); }
.divider { height:1px; background:linear-gradient(90deg,transparent,var(--gold-pale),transparent); margin:4px 20px; }

/* ── WELCOME ── */
.welcome-card {
  background:var(--dark); border-radius:var(--radius); padding:28px 24px;
  margin:0 20px; position:relative; overflow:hidden;
}
.welcome-card::before {
  content:''; position:absolute; top:-40px; right:-40px;
  width:160px; height:160px; border-radius:50%;
  background:radial-gradient(circle,rgba(154,134,96,.2) 0%,transparent 70%); pointer-events:none;
}
.welcome-card p { font-size:.95rem; font-weight:300; color:rgba(250,248,244,.75); line-height:1.8; margin-bottom:20px; }
.welcome-card p strong { color:var(--white); font-weight:500; }
.contact-btns { display:flex; flex-direction:column; gap:10px; }
.contact-btn { display:flex; align-items:center; gap:14px; background:var(--gold); border-radius:12px; padding:14px 18px; text-decoration:none; transition:all .2s; }
.contact-btn:active { transform:scale(.97); filter:brightness(.93); }
.cbtn-icon { width:38px; height:38px; background:rgba(255,255,255,.18); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
.cbtn-text .label { font-size:.7rem; font-weight:400; color:rgba(255,255,255,.7); letter-spacing:.1em; text-transform:uppercase; }
.cbtn-text .name { font-size:1rem; font-weight:600; color:white; }
.cbtn-text .number { font-size:.85rem; font-weight:500; color:rgba(255,255,255,.85); letter-spacing:.05em; }

/* ── ADDRESS ── */
.address-card { background:var(--card); border-radius:var(--radius); overflow:hidden; box-shadow:var(--shadow); }
.addr-map { height:150px; background:linear-gradient(135deg,#2a3520,#3a4a2a,#2a3520); display:flex; align-items:center; justify-content:center; position:relative; overflow:hidden; }
.addr-map::before { content:''; position:absolute; inset:0; background-image:repeating-linear-gradient(0deg,rgba(154,134,96,.08) 0,rgba(154,134,96,.08) 1px,transparent 0,transparent 30px),repeating-linear-gradient(90deg,rgba(154,134,96,.08) 0,rgba(154,134,96,.08) 1px,transparent 0,transparent 30px); }
.map-pin { font-size:2.4rem; position:relative; z-index:2; filter:drop-shadow(0 4px 12px rgba(0,0,0,.4)); animation:bounce 2s ease-in-out infinite; }
@keyframes bounce { 0%,100%{transform:translateY(0)} 50%{transform:translateY(-8px)} }
.addr-body { padding:20px; }
.addr-body h3 { font-family:'Playfair Display',serif; font-size:1.05rem; font-weight:500; margin-bottom:6px; }
.addr-body p { font-size:.88rem; color:var(--muted); line-height:1.7; margin-bottom:14px; }
.addr-steps { display:flex; flex-direction:column; gap:8px; margin-bottom:14px; }
.addr-step { display:flex; align-items:center; gap:12px; background:var(--bg2); border-radius:10px; padding:10px 14px; font-size:.85rem; color:var(--mid); }
.step-icon { font-size:1.1rem; flex-shrink:0; }
.maps-btn { display:flex; align-items:center; justify-content:center; gap:8px; background:var(--dark); color:white; border-radius:10px; padding:13px; text-decoration:none; font-size:.85rem; font-weight:500; transition:background .2s; }
.maps-btn:active { background:var(--gold); }

/* ── WIFI ── */
.wifi-card { background:var(--dark); border-radius:var(--radius); padding:22px 20px; box-shadow:var(--shadow-lg); }
.wifi-head { display:flex; align-items:center; gap:12px; margin-bottom:18px; }
.wifi-ico { width:44px; height:44px; background:var(--gold); border-radius:12px; display:flex; align-items:center; justify-content:center; font-size:1.3rem; flex-shrink:0; }
.wifi-ttl { font-family:'Playfair Display',serif; font-size:1.1rem; color:var(--white); }
.wifi-ttl small { display:block; font-family:'Outfit',sans-serif; font-size:.72rem; font-weight:300; color:var(--gold-light); }
.wifi-row { background:rgba(255,255,255,.05); border:1px solid rgba(255,255,255,.08); border-radius:10px; padding:13px 16px; display:flex; justify-content:space-between; align-items:center; margin-bottom:8px; }
.wlabel { font-size:.72rem; letter-spacing:.1em; text-transform:uppercase; color:rgba(250,248,244,.4); }
.wvalue { font-size:.95rem; font-weight:500; color:var(--white); }
.wvalue.mono { font-family:'Courier New',monospace; font-size:.88rem; color:var(--gold-light); }
.copy-btn { background:var(--gold); border:none; border-radius:8px; padding:10px 12px; font-family:'Outfit',sans-serif; font-size:.82rem; font-weight:500; color:white; cursor:pointer; transition:all .2s; width:100%; margin-top:4px; display:block; text-align:center; text-decoration:none; }
.copy-btn:active { transform:scale(.96); }
.wifi-qr-wrap { margin-top:18px; display:flex; flex-direction:column; align-items:center; gap:8px; }
.wifi-qr-label { font-size:.68rem; font-weight:400; letter-spacing:.15em; text-transform:uppercase; color:rgba(250,248,244,.35); }
.wifi-qr-img { width:148px; height:148px; border-radius:12px; background:white; padding:10px; display:block; }

/* ── STEP LIST (arrivée) ── */
.step-card { background:var(--card); border-radius:var(--radius); padding:22px 20px; box-shadow:var(--shadow); }
.step-list { display:flex; flex-direction:column; }
.step-item { display:flex; gap:16px; padding:14px 0; border-bottom:1px solid var(--bg2); }
.step-item:last-child { border-bottom:none; }
.step-num-col { display:flex; flex-direction:column; align-items:center; flex-shrink:0; }
.step-num { width:34px; height:34px; border-radius:50%; background:var(--gold); color:white; font-size:.85rem; font-weight:600; display:flex; align-items:center; justify-content:center; }
.step-line { width:1px; flex:1; background:var(--gold-pale); margin-top:4px; }
.step-item:last-child .step-line { display:none; }
.step-body { flex:1; padding-top:4px; }
.step-body h4 { font-size:.85rem; font-weight:600; color:var(--dark); margin-bottom:3px; text-transform:uppercase; letter-spacing:.06em; }
.step-body p { font-size:.85rem; color:var(--muted); line-height:1.6; }
.code-hl { display:inline-block; background:var(--dark); color:var(--gold-light); font-family:'Courier New',monospace; font-size:1.3rem; font-weight:700; letter-spacing:.25em; padding:7px 16px; border-radius:8px; margin-top:8px; }

/* ── DÉPART ── */
.depart-card { background:var(--card); border-radius:var(--radius); padding:20px; box-shadow:var(--shadow); }
.dep-item { display:flex; align-items:flex-start; gap:14px; padding:12px 0; border-bottom:1px solid var(--bg2); }
.dep-item:last-child { border-bottom:none; }
.dep-ico { width:40px; height:40px; background:var(--bg2); border-radius:10px; display:flex; align-items:center; justify-content:center; font-size:1.2rem; flex-shrink:0; }
.dep-body h4 { font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--dark); margin-bottom:2px; }
.dep-body p { font-size:.83rem; color:var(--muted); line-height:1.6; }

/* ── RULES ── */
.rules-list { display:flex; flex-direction:column; gap:10px; }
.rule-card { background:var(--card); border-radius:var(--radius); padding:16px 18px; display:flex; align-items:center; gap:14px; box-shadow:var(--shadow); }
.rule-ico { font-size:1.6rem; flex-shrink:0; width:44px; text-align:center; }
.rule-body h4 { font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--red); margin-bottom:2px; }
.rule-body p { font-size:.83rem; color:var(--muted); line-height:1.5; }

/* ── IMPORTANT ── */
.imp-card { background:var(--card); border-radius:var(--radius); padding:18px; box-shadow:var(--shadow); border-left:4px solid var(--gold); margin-bottom:10px; }
.imp-card:last-child { margin-bottom:0; }
.imp-card h4 { font-size:.8rem; font-weight:600; text-transform:uppercase; letter-spacing:.1em; color:var(--gold); margin-bottom:8px; display:flex; align-items:center; gap:8px; }
.imp-card p { font-size:.85rem; color:var(--mid); line-height:1.7; }

/* ── LOISIRS ── */
.loisirs-grid { display:grid; grid-template-columns:repeat(2,1fr); gap:10px; }
.loisir-card { background:var(--card); border-radius:var(--radius); padding:14px 10px; box-shadow:var(--shadow); text-align:center; }
.loisir-card:active { transform:scale(.96); }
.loisir-card .ico { font-size:1.6rem; display:block; margin-bottom:6px; }
.loisir-card h4 { font-size:.72rem; font-weight:600; text-transform:uppercase; letter-spacing:.06em; color:var(--dark); margin-bottom:4px; }
.loisir-card p { font-size:.72rem; color:var(--muted); line-height:1.4; }

/* ── TORTUES ── */
.tortues-wrap { background:linear-gradient(135deg,#2d4a24,#3a5c2e); border-radius:var(--radius); padding:24px 20px; overflow:hidden; position:relative; }
.tortues-wrap::before { content:'🌿'; position:absolute; font-size:6rem; opacity:.07; top:-10px; right:-10px; transform:rotate(20deg); pointer-events:none; }
.tortues-wrap .chip { background:rgba(255,255,255,.12); color:rgba(255,255,255,.7); }
.tortues-wrap .section-title { color:white; margin-bottom:6px; }
.tortues-wrap .section-sub { font-size:.88rem; color:rgba(255,255,255,.6); margin-bottom:16px; }
.tortues-grid { display:grid; grid-template-columns:1fr 1fr; gap:10px; }
.tortue-item { background:rgba(255,255,255,.08); border:1px solid rgba(255,255,255,.12); border-radius:12px; padding:14px; }
.tortue-item .ico { font-size:1.5rem; display:block; margin-bottom:8px; }
.tortue-item h4 { font-size:.76rem; font-weight:600; color:#a8d48a; text-transform:uppercase; letter-spacing:.07em; margin-bottom:4px; }
.tortue-item p { font-size:.8rem; color:rgba(255,255,255,.65); line-height:1.5; }

/* ── ADRESSES ── */
.adresses-list { display:flex; flex-direction:column; gap:12px; }
.adr-card { background:var(--card); border-radius:var(--radius); padding:18px; box-shadow:var(--shadow); }
.adr-card[onclick] { transition:transform .2s, box-shadow .2s; }
.adr-card[onclick]:active { transform:scale(.97); box-shadow:var(--shadow-lg); }
.adr-card[onclick] .adr-head h3::after { content:' ↗'; font-size:.75rem; color:var(--gold); opacity:.6; }
.adr-head { display:flex; align-items:center; gap:12px; margin-bottom:12px; padding-bottom:12px; border-bottom:1px solid var(--bg2); }
.adr-flag { width:54px; height:54px; border-radius:12px; background:var(--bg2); display:flex; align-items:center; justify-content:center; font-size:1.4rem; flex-shrink:0; object-fit:cover; }
.adr-city-img { display:none; }
.adr-head h3 { font-family:'Playfair Display',serif; font-size:1rem; font-weight:500; color:var(--dark); flex:1; }
.adr-items { display:flex; flex-direction:column; gap:6px; }
.adr-item { font-size:.85rem; color:var(--mid); line-height:1.5; padding:3px 0; display:flex; align-items:baseline; gap:6px; }
.adr-item::before { content:'→'; color:var(--gold); font-size:.7rem; flex-shrink:0; }
.adr-item a { color:var(--gold); text-decoration:none; font-weight:500; }
.warn-badge { display:inline-flex; align-items:center; gap:6px; background:#fff3cd; border:1px solid #ffc107; border-radius:8px; padding:6px 12px; font-size:.78rem; font-weight:600; color:#856404; margin-top:10px; }

/* ── LIENS ── */

/* POI Map button */
.poi-btn {
  display:flex; align-items:center; gap:12px;
  background:linear-gradient(135deg, var(--gold) 0%, #7a6840 100%);
  border-radius:14px; padding:14px 16px;
  text-decoration:none; margin-bottom:14px;
  box-shadow:0 4px 18px rgba(154,134,96,.35);
  transition:transform .15s, box-shadow .15s;
}
.poi-btn:active { transform:scale(.97); box-shadow:0 2px 10px rgba(154,134,96,.2); }
.poi-btn-ico { font-size:2rem; flex-shrink:0; }
.poi-btn-body { flex:1; display:flex; flex-direction:column; gap:2px; }
.poi-btn-body strong { font-size:.9rem; font-weight:600; color:#fff; }
.poi-btn-body span { font-size:.75rem; color:rgba(255,255,255,.75); }
.poi-btn-arrow { font-size:1.1rem; color:rgba(255,255,255,.8); flex-shrink:0; }
.liens-list { display:flex; flex-direction:column; gap:6px; }
.lien-card { background:var(--card); border-radius:10px; padding:10px 14px; box-shadow:var(--shadow); display:flex; align-items:center; gap:10px; text-decoration:none; }
.lien-card:active { transform:scale(.97); }
.lien-thumb { width:34px; height:34px; border-radius:8px; background:var(--bg2); display:flex; align-items:center; justify-content:center; font-size:1.1rem; flex-shrink:0; }
.lien-body h4 { font-size:.8rem; font-weight:600; color:var(--dark); margin-bottom:0; text-decoration:underline; text-decoration-color:var(--gold); }
.lien-body p { font-size:.72rem; color:var(--muted); line-height:1.3; }
.lien-arrow { margin-left:auto; font-size:.85rem; color:var(--gold); flex-shrink:0; }

/* ── VILLA PRÉSENTATION ── */
.villa-intro { background:var(--dark); padding:32px 20px 28px; }
.villa-intro .chip { background:rgba(154,134,96,.2); }
.villa-intro .section-title { color:var(--white); margin-bottom:14px; }
.villa-desc { font-size:.92rem; font-weight:300; color:rgba(250,248,244,.65); line-height:1.85; margin-bottom:22px; }
.villa-desc strong { color:var(--gold-light); font-weight:500; }

.villa-distances {
  display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-bottom:24px;
}
.dist-item {
  background:rgba(255,255,255,.05); border:1px solid rgba(154,134,96,.2);
  border-radius:12px; padding:14px 10px; text-align:center;
}
.dist-min { font-family:'Playfair Display',serif; font-size:1.6rem; color:var(--gold-light); line-height:1; }
.dist-unit { font-size:.58rem; color:var(--gold-light); letter-spacing:.12em; text-transform:uppercase; }
.dist-label { font-size:.72rem; color:rgba(250,248,244,.45); margin-top:4px; }

.villa-specs-grid {
  display:grid; grid-template-columns:1fr 1fr; gap:10px; margin-bottom:24px;
}
.spec-item {
  background:rgba(255,255,255,.05); border:1px solid rgba(154,134,96,.15);
  border-radius:12px; padding:14px 14px; display:flex; align-items:flex-start; gap:12px;
}
.spec-ico { font-size:1.4rem; flex-shrink:0; line-height:1; margin-top:2px; }
.spec-body h4 { font-size:.76rem; font-weight:600; text-transform:uppercase; letter-spacing:.08em; color:var(--gold-light); margin-bottom:3px; }
.spec-body p { font-size:.8rem; color:rgba(250,248,244,.55); line-height:1.5; }

/* photo gallery */

/* Villa photo gallery */
.gallery-wrap {
  position:relative;
  display:flex; align-items:center; gap:0;
}
.gallery-scroll {
  flex:1; display:flex; gap:10px; overflow-x:auto; padding-bottom:6px;
  scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch;
}
.gallery-scroll::-webkit-scrollbar { display:none; }
.gallery-img {
  width:65vw; max-width:260px; height:180px;
  border-radius:12px; object-fit:cover; flex-shrink:0;
  scroll-snap-align:start;
  border:1px solid rgba(154,134,96,.15);
}
/* Flèches de navigation — visibles uniquement à la souris */
.gallery-arrow {
  display:none;
  flex-shrink:0;
  width:40px; height:40px;
  background:rgba(26,22,18,.82); backdrop-filter:blur(8px);
  border:1px solid rgba(154,134,96,.4); border-radius:50%;
  color:var(--gold-light); font-size:1.1rem; line-height:1;
  cursor:pointer; z-index:10;
  align-items:center; justify-content:center;
  transition:background .2s, opacity .2s;
  padding:0;
}
.gallery-arrow:hover { background:var(--gold); color:white; }
.gallery-arrow:active { opacity:.7; }
.gallery-arrow.hidden { opacity:0; pointer-events:none; }
@media (hover:hover) and (pointer:fine) {
  .gallery-arrow { display:flex; }
}

.airbnb-btn {
  display:flex; align-items:center; justify-content:center; gap:10px;
  background:linear-gradient(135deg,#FF5A5F,#E0334C);
  color:white; border-radius:12px; padding:16px 20px;
  text-decoration:none; font-size:.9rem; font-weight:600;
  margin-top:22px; transition:all .2s;
  box-shadow: 0 4px 20px rgba(255,90,95,.3);
}
.airbnb-btn:active { transform:scale(.97); }
.airbnb-stars { display:flex; align-items:center; gap:6px; font-size:.8rem; color:rgba(255,255,255,.8); margin-top:6px; }

.airbnb-meta {
  background:rgba(255,90,95,.08); border:1px solid rgba(255,90,95,.2);
  border-radius:12px; padding:14px 16px; margin-top:14px;
}
.airbnb-meta-row { display:flex; align-items:center; gap:10px; margin-bottom:6px; }
.airbnb-meta-row:last-child { margin-bottom:0; }
.airbnb-meta-ico { font-size:1.1rem; flex-shrink:0; }
.airbnb-meta-text { font-size:.82rem; color:rgba(250,248,244,.6); }
.airbnb-meta-text strong { color:var(--gold-light); }

/* ── FOOTER ── */
.footer { background:var(--dark); padding:36px 20px 48px; text-align:center; }
.footer-video { width:160px; height:160px; object-fit:cover; border-radius:8px; margin:0 auto 12px; display:block; }
.footer-title { font-family:'Playfair Display',serif; font-size:1.4rem; color:var(--white); letter-spacing:.05em; margin-bottom:4px; }
.footer-sub { font-size:.7rem; font-weight:300; letter-spacing:.25em; text-transform:uppercase; color:var(--gold-light); margin-bottom:20px; }
.footer-msg { font-size:.85rem; font-weight:300; color:rgba(250,248,244,.45); line-height:1.8; max-width:320px; margin:0 auto 20px; }
.footer-divider { height:1px; background:rgba(154,134,96,.2); margin:20px 0; }
.footer-note { font-size:.7rem; color:rgba(250,248,244,.18); letter-spacing:.08em; }

/* ── NAV PILLS ── */
.nav-pills {
  position:sticky; top:64px; z-index:150;
  background:rgba(244,240,232,0.97);
  backdrop-filter:blur(10px); -webkit-backdrop-filter:blur(10px);
  border-bottom:1px solid var(--gold-pale);
  display:flex; gap:8px; overflow-x:auto; padding:10px 16px;
  scroll-snap-type:x mandatory; -webkit-overflow-scrolling:touch;
}
.nav-pills::-webkit-scrollbar { display:none; }
.nav-pill {
  display:flex; flex-direction:column; align-items:center; gap:4px;
  background:var(--card); border:1px solid var(--gold-pale);
  border-radius:14px; padding:10px 14px;
  text-decoration:none; flex-shrink:0;
  scroll-snap-align:start;
  transition:background .2s, border-color .2s, transform .15s;
  min-width:72px;
}
.nav-pill:active { transform:scale(.93); }
.nav-pill.active { background:var(--dark); border-color:var(--dark); }
.nav-pill .pill-ico { font-size:1.3rem; line-height:1; }
.nav-pill .pill-label {
  font-size:.58rem; font-weight:500; letter-spacing:.06em;
  text-transform:uppercase; color:var(--muted); text-align:center;
  white-space:nowrap;
}
.nav-pill.active .pill-label { color:var(--gold-light); }

/* ── REVEAL ── */
.reveal { opacity:1; transform:none; }
.reveal.will-animate { opacity:0; transform:translateY(18px); transition:opacity .55s ease,transform .55s ease; }
.reveal.will-animate.in { opacity:1; transform:none; }

/* ── FAB ── */
.fab { position:fixed; bottom:24px; right:20px; width:46px; height:46px; background:var(--dark); border:1px solid rgba(154,134,96,.35); border-radius:50%; display:flex; align-items:center; justify-content:center; font-size:1.1rem; color:var(--gold-light); cursor:pointer; z-index:100; opacity:0; transform:translateY(10px); transition:opacity .3s,transform .3s; box-shadow:0 4px 20px rgba(0,0,0,.3); }
.fab.visible { opacity:1; transform:none; }
.fab:active { transform:scale(.9) !important; }

/* ── RESPONSIVE ── */
/* ── Mobile small (<380px) ── */
@media(max-width:380px){
  body { font-size:14px; }
  .topbar { padding:10px 14px; gap:8px; }
  .logo-video { width:48px; height:48px; }
  .logo-text { font-size:.85rem; }
  .section { padding:20px 14px; }
  .villa-intro { padding:20px 14px 16px; }
  .hero { padding:24px 16px 20px; }
  .section-title { font-size:1.3rem; }
  .contact-btn { padding:12px; }
  .cbtn-text .name { font-size:.9rem; }
  .loisirs-grid { grid-template-columns:repeat(3,1fr); }
  .tortues-grid { grid-template-columns:repeat(2,1fr); }
  .nav-pill { min-width:60px; padding:6px 10px; }
  .nav-pill .pill-ico { font-size:1.1rem; }
  .pill-label { font-size:.52rem; }
  .wifi-qr-img { width:120px; height:120px; }
  .gallery-img { width:78vw; height:160px; }
  .hero-logo-img { width:min(200px,50vw); }
  .villa-distances { grid-template-columns:1fr 1fr; }
  .villa-specs-grid { grid-template-columns:1fr 1fr; }
}
@media(min-width:600px){
  .section{padding:36px 28px;}
  .welcome-card{margin:0 28px;}
  .divider{margin:4px 28px;}
  .contact-btns{flex-direction:row;}
  .contact-btn{flex:1;}
  .loisirs-grid{grid-template-columns:repeat(5,1fr);}
  .tortues-grid{grid-template-columns:repeat(4,1fr);}
  .villa-intro{padding:36px 28px 28px;}
  .villa-specs-grid{grid-template-columns:repeat(3,1fr);}
  .gallery-img{width:44vw;max-width:320px;}
  .villa-distances{grid-template-columns:repeat(3,1fr);}
}
@media(min-width:860px){
  body{max-width:760px;margin:0 auto;}
  .topbar{padding:16px 32px;}
  .hero{max-height:300px;padding:36px 40px;}
}

/* Lightbox */
#lb {
  display:flex; position:fixed; inset:0; z-index:9999;
  background:rgba(0,0,0,.93);
  align-items:center; justify-content:center; padding:20px;
  opacity:0; pointer-events:none; transition:opacity .22s;
}
#lb.on { opacity:1; pointer-events:all; }
#lb img { max-width:100%; max-height:88vh; border-radius:12px; object-fit:contain; box-shadow:0 8px 50px rgba(0,0,0,.6); user-select:none; }
#lb-close {
  position:absolute; top:14px; right:18px;
  background:none; border:none; color:#fff;
  font-size:2rem; cursor:pointer; line-height:1; opacity:.75;
}
#lb-close:hover { opacity:1; }
</style>
<script>
function lbShow(src, alt) {
  var el = document.getElementById('lb');
  var im = document.getElementById('lb-img');
  if (!el || !im) return;
  im.src = src; im.alt = alt || '';
  el.classList.add('on');
  document.body.style.overflow = 'hidden';
}
function lbHide() {
  var el = document.getElementById('lb');
  if (!el) return;
  el.classList.remove('on');
  document.body.style.overflow = '';
}

function setLang(lang) {
  document.querySelectorAll('[data-fr],[data-en]').forEach(function(el) {
    var val = el.getAttribute('data-' + lang);
    if (val === null) return;
    if (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA') {
      el.placeholder = val;
    } else {
      el.innerHTML = val;
    }
  });
  document.querySelectorAll('.lang-btn').forEach(function(btn) {
    btn.classList.toggle('active', btn.getAttribute('onclick').includes("'" + lang + "'"));
  });
  localStorage.setItem('lang', lang);
}
// Auto-restore language
(function() {
  var saved = localStorage.getItem('lang');
  if (saved) setLang(saved);
})();


// Ajuste la taille du texte marquee à la hauteur du hero
function setMarqueeSize() {
  var hero = document.querySelector('.hero');
  if (!hero) return;
  var h = hero.offsetHeight;
  if (h === 0) return;
  hero.style.setProperty('--hero-h', h + 'px');
}
window.addEventListener('load', setMarqueeSize);
window.addEventListener('resize', setMarqueeSize);

function galleryScroll(dir) {
  var el = document.getElementById('gallery-scroll');
  if (!el) return;
  var img = el.querySelector('.gallery-img');
  var step = img ? img.offsetWidth + 10 : 260;
  el.scrollBy({ left: dir === 'next' ? step : -step, behavior: 'smooth' });
}
function updateGalleryArrows() {
  var el = document.getElementById('gallery-scroll');
  var prev = document.getElementById('gallery-prev');
  var next = document.getElementById('gallery-next');
  if (!el || !prev || !next) return;
  prev.classList.toggle('hidden', el.scrollLeft <= 4);
  next.classList.toggle('hidden', el.scrollLeft + el.clientWidth >= el.scrollWidth - 4);
}

document.addEventListener('DOMContentLoaded', function() {
  var g = document.getElementById('gallery-scroll');
  if (g) {
    g.addEventListener('scroll', updateGalleryArrows, {passive:true});
    updateGalleryArrows();
    g.querySelectorAll('.gallery-img').forEach(function(img) {
      img.style.cursor = 'zoom-in';
      img.addEventListener('click', function(e) {
        e.stopPropagation();
        lbShow(this.src, this.alt);
      });
    });
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') lbHide();
  });});


</script>
</head>
